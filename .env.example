# Model provider used by Agno agents.
MODEL_PROVIDER=groq
MODEL_ID=llama-3.3-70b-versatile
USE_LLM_AGENTS=true

# Do not commit real API keys. Copy this file to .env and fill locally.
GROQ_API_KEY=your-groq-api-key

# Local runtime state. These paths are safe examples and can be recreated.
DATABASE_PATH=storage/requirements.db
KNOWLEDGE_BASE_PATH=storage/knowledge_base
